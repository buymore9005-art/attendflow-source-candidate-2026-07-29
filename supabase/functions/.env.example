# Supabase injects these values in deployed Edge Functions. Keep the names here
# so local/alternative runtimes have an explicit contract; do not commit real keys.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SITE_URL=http://localhost:5173

APP_URL=http://localhost:5173

# Generate with: openssl rand -base64 32
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

# Generate with: openssl rand -hex 32
CRON_SECRET=REPLACE_WITH_RANDOM_CRON_SECRET

# Comma-separated HTTPS origins, without paths. Leave empty when the optional
# outbound payroll webhook is disabled.
DELI_PAYROLL_WEBHOOK_ALLOWED_ORIGINS=
